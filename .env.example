# WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=choose_any_text
# The bot's actual WhatsApp number, country code first, no + (used in ad links)
WHATSAPP_DISPLAY_NUMBER=91XXXXXXXXXX

# Client's WhatsApp number (reports/alerts go here, and it can run admin commands)
CLIENT_PHONE=91XXXXXXXXXX

# Meta Marketing API
META_ACCESS_TOKEN=your_long_lived_token
META_AD_ACCOUNT_ID=act_your_ad_account_id
META_PAGE_ID=your_facebook_page_id
# Ad set and ads made in Ads Manager. Add one META_AD_ID_<CODE> line per ad.
META_AD_SET_ID=your_ad_set_id
META_AD_ID_P1=your_poster_ad_id
META_AD_ID_V1=your_video_ad_id

# Claude API
CLAUDE_API_KEY=your_claude_api_key

# Google
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----"

# App
PORT=3000
NODE_ENV=development
